{
  "uid": "skeleton-session",
  "title": "Skeleton session",
  "tags": [
    "skeleton",
    "game",
    "session"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "skeleton-db"
        },
        "definition": "SELECT id::text AS __text, id::text AS __value FROM sessions ORDER BY started_at DESC LIMIT 20",
        "query": "SELECT id::text AS __text, id::text AS __value FROM sessions ORDER BY started_at DESC LIMIT 20",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Startup",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Load, ms",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(load_ms::numeric, 0) AS load_ms FROM sessions WHERE id = '$session'::uuid",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3000
              },
              {
                "color": "red",
                "value": 6000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "First frame, ms",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(first_frame_ms::numeric, 0) AS first_frame FROM sessions WHERE id = '$session'::uuid",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3000
              },
              {
                "color": "red",
                "value": 6000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "First 12 seconds",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM (x.ts - s.started_at))::numeric, 1) AS second,\n                    x.fps, x.p95, x.max, x.chunks, x.grass_pending, x.chunk_queue\n             FROM samples x JOIN sessions s ON s.id = x.session_id\n             WHERE x.session_id = '$session'::uuid\n               AND x.ts <= s.started_at + interval '12 seconds'\n             ORDER BY x.ts"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 110,
      "type": "row",
      "title": "Performance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Frame time, ms",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, fps, p95, max FROM samples WHERE session_id = '$session'::uuid ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Chunks and grass",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, chunks, grass_tiles, grass_pending, chunk_queue FROM samples WHERE session_id = '$session'::uuid ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Hitches",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, kind, round(ms::numeric, 1) AS ms, data FROM events WHERE session_id = '$session'::uuid AND kind = 'hitch' ORDER BY ts DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host: GPU and CPU",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, gpu_util, gpu_mem_mb, cpu_load FROM host_samples WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 129,
      "type": "row",
      "title": "Renderer",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Draw calls and triangles",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, calls, triangles FROM samples WHERE session_id = '$session'::uuid ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Heap, MB",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, heap_mb FROM samples WHERE session_id = '$session'::uuid ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Device",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 18,
        "y": 30,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT backend, gpu, width, height, round(pixel_ratio::numeric, 2) AS pixel_ratio\n             FROM sessions WHERE id = '$session'::uuid"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 138,
      "type": "row",
      "title": "Errors in this session",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Errors",
      "datasource": {
        "type": "postgres",
        "uid": "skeleton-db"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts, kind, COALESCE(data->>'kind', '') AS subtype,\n                    COALESCE(data->>'fingerprint', 'contextlost') AS fingerprint,\n                    left(COALESCE(data->>'message', 'WebGL context lost'), 120) AS message\n             FROM events\n             WHERE session_id = '$session'::uuid AND kind IN ('error','contextlost')\n             ORDER BY ts DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "links": [
    {
      "title": "Game health",
      "url": "/d/skeleton-telemetry",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ]
}
